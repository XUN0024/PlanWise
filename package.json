{
  "name": "planwise",
  "version": "1.0.0",
  "main": "public/main.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "electron": "electron public/main.js",
    "electron-dev": "cross-env NODE_ENV=development electron public/main.js",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "dev-desktop": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron-dev\" --kill-others-on-fail",
    "desktop-only": "concurrently \"npm run start -- --open=false\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XUN0024/PlanWise.git"
  },
